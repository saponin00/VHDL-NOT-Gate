    <comp name="Text" loc="(70,440)" lib="9">
      <a name="text" val="AND = 1 only when a=b=c=d=1." />
      <a name="font" val="SansSerif plain 13" />
      <a name="halign" val="left" />
    </comp>
    <comp name="Text" loc="(70,465)" lib="9">
      <a name="text" val="OR = 1 when at least one input is 1." />
      <a name="font" val="SansSerif plain 13" />
      <a name="halign" val="left" />
    </comp>
  </circuit>
  <vhdl appearance="logisim_evolution" name="logic4">library ieee;
use ieee.std_logic_1164.all;

-- Problem 1: four-input AND and OR gates.
entity logic4 is
    port (
        a, b, c, d : in  std_logic;
        out1       : out std_logic;
        out2       : out std_logic
    );
end entity logic4;

architecture rtl of logic4 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture rtl;
</vhdl>
</project>