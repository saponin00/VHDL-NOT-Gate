    <wire from="(150,200)" to="(280,200)" />
    <comp name="Pin" loc="(650,200)" lib="0">
      <a name="appearance" val="NewPins" />
      <a name="facing" val="west" />
      <a name="type" val="output" />
      <a name="width" val="1" />
      <a name="label" val="result" />
      <a name="labelloc" val="north" />
      <a name="radix" val="2" />
      <a name="initial" val="0x0" />
    </comp>
    <wire from="(500,200)" to="(650,200)" />
    <comp name="Text" loc="(70,440)" lib="9">
      <a name="text" val="vt is hexadecimal. 0000FFF = 12 yes votes; 0001FFF = 13 yes votes." />
      <a name="font" val="SansSerif plain 13" />
      <a name="halign" val="left" />
    </comp>
    <comp name="Text" loc="(70,465)" lib="9">
      <a name="text" val="A strict majority requires at least 13 votes." />
      <a name="font" val="SansSerif plain 13" />
      <a name="halign" val="left" />
    </comp>
  </circuit>
  <vhdl appearance="logisim_evolution" name="vote25">library ieee;
use ieee.std_logic_1164.all;

-- Problem 4: a strict majority of 25 voters requires at least 13 votes.
entity vote25 is
    port (
        vt     : in  std_logic_vector(25 downto 1);
        result : out std_logic
    );
end entity vote25;

architecture rtl of vote25 is
begin
    process(vt)
        variable sum : integer range 0 to 25;
    begin
        sum := 0;
        for i in vt'range loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        if sum &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture rtl;
</vhdl>
</project>