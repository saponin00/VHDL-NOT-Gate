    <a name="circuit" val="P4_vote25" />
    <a name="circuitnamedboxfixedsize" val="true" />
    <a name="simulationFrequency" val="1.0" />
    <comp name="Text" loc="(70,40)" lib="9">
      <a name="text" val="4. Twenty-five-person majority vote" />
      <a name="font" val="SansSerif bold 18" />
